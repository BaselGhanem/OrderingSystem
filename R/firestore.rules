rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // IMPORTANT SECURITY NOTE:
    // This Returns site intentionally does not use Firebase Authentication.
    // Firestore therefore cannot verify the local application role server-side.
    // Rules restrict access to the Returns data model, but they cannot distinguish
    // representatives, supervisors or admins without Authentication/backend identity.

    match /returns_requests/{requestId} {
      allow read, create, update: if true;
      allow delete: if false;

      // Immutable-style audit events are written by the application with serverTimestamp().
      match /audit/{eventId} {
        allow read, create: if true;
        allow update, delete: if false;
      }
    }

    // Atomic ledger used to prevent concurrent returns from exceeding historical sales.
    match /return_allocations/{saleId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /returns_pharmacies/{pharmacyId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /returns_sales_chunks/{chunkId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    match /returns_imports/{uploadId} {
      allow read, create, update: if true;
      allow delete: if false;
    }

    // User directory for the Returns login screen. Passwords are never stored as plaintext.
    match /returns_users_config/{userId} {
      allow read, create, update, delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
